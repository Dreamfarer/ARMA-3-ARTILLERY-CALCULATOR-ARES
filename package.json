{
  "name": "ares",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:worker",
    "dev": "next dev --turbopack",
    "build": "npm run build:worker && next build",
    "build:encode": "ts-node --project tsconfig.scripts.json --transpile-only scripts/encode-csv.ts",
    "build:worker": "ts-node --project tsconfig.scripts.json --transpile-only scripts/copy-maplibre-worker.ts",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "maplibre-gl": "^6.9.0",
    "next": "^16.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.31.0",
    "eslint-config-next": "^16.3.4",
    "fast-csv": "^5.0.2",
    "prettier": "3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
